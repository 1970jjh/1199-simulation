{
  "rules": {
    "games": {
      // Allow reading the full room list (needed for subscribeToGameRooms)
      ".read": true,

      "$roomId": {
        // Allow full write only for new rooms (creation)
        ".write": true,

        "currentRound": {
          // CRITICAL: Prevent round rollback.
          // currentRound can only stay the same or increase, never decrease.
          // This is the server-level safety net: even if a client has a bug
          // and tries to write stale data (e.g., round 3 when game is at round 6),
          // Firebase will reject the write.
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9 && (data.val() == null || newData.val() >= data.val())"
        },

        "roundHistory": {
          "$roundKey": {
            // Each round result: allow creation, allow overwrite, but prevent deletion.
            // This stops stale writes from erasing completed round results.
            ".validate": "!data.exists() || newData.val() != null"
          }
        },

        "phase": {
          // Phase transitions: SETUP -> PLAYING -> ENDED (forward-only)
          // Prevents rolling back from PLAYING to SETUP, etc.
          ".validate": "newData.isString() && (newData.val() == 'SETUP' || newData.val() == 'PLAYING' || newData.val() == 'ENDED')"
        },

        "pendingSubmissions": {
          "$teamId": {
            // Individual team submissions: anyone can write their own team's submission
            ".validate": "newData.hasChildren(['card1', 'card2'])"
          }
        }
      }
    }
  }
}
